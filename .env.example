# KisanSetu Environment Variables Example
SECRET_KEY=kisansetu-super-secret-key-sih-2026
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# MySQL Database Configuration
# Default connection format: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=mysql+pymysql://root:@localhost:3306/kisansetu_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=kisansetu_db

# Fallback: Set to 1 or True to use local SQLite if MySQL is not reachable
ENABLE_SQLITE_FALLBACK=True

# Demo Mode Settings
DEMO_MODE=True
REQUIRE_DEMO_AADHAAR=True
